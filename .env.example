# Copy this file to .env and fill in real values. Never commit .env itself.
#
# This file only lists what's needed before the app can even reach its own
# database (UI_HOST/UI_PORT/UI_DB_PATH), infrastructure endpoints an
# operator might need to point somewhere non-default (the MQTT broker
# host, SENAPRED's Cognito/AppSync identity), and secrets. Every other
# setting — adapter poll intervals, dispatcher/actions/beacon tuning,
# MQTT topics, beacon schedule/templates/voice/AX.25/TTS config, display
# timezone, UI page size/refresh intervals/dev-tools toggle, etc. — is
# edited live, with no restart, from the running app's /config page
# (backed by ui/src/ui/config_catalog.py's SETTINGS_CATALOG), not here.
# Every one of those settings still honors an identically-named env var
# if you set one (see adapters.storage.get_setting's resolution order:
# DB row -> env var -> hardcoded default) — this file just no longer
# documents each one individually, since /config's own descriptions are
# the single source of truth for defaults now.
#
# Naming convention: vars specific to one adapter are prefixed with the
# adapter's name (e.g. ADAPTERS_SENAPRED_*); generic vars (used across
# adapters, or read directly by a third-party SDK under its own standard
# name) have no prefix.

# --- Bootstrap (ui.config) — needed before the UI can open the database
# at all, so these can never be DB-backed like every other setting. ---

# Host/port ui/start.sh binds to. Defaults to 0.0.0.0 (reachable from the
# LAN) — there is no auth yet, so only run this on a trusted network. Set
# to 127.0.0.1 to keep it off the network entirely (loopback-only).
UI_HOST=0.0.0.0
UI_PORT=8080

# Path to radiobeacon.db. Leave unset to use the same default every other
# package uses (adapters.storage.DEFAULT_DB_PATH, storage/radiobeacon.db).
# UI_DB_PATH=

# --- MQTT broker hosts — uncomment only if your broker isn't on
# localhost (the default every package assumes; see mq/README.md). Port/
# QoS/timeout for each is DB-editable via /config once the app is
# running. ---
# DISPATCHER_MQ_HOST=localhost
# ACTIONS_MQ_HOST=localhost
# BEACON_MQ_HOST=localhost

# --- SENAPRED adapter identity/AWS plumbing — public, non-secret values
# reverse-engineered from senapred.cl's own JS bundle (see
# data-adapters/src/adapters/senapred/__init__.py); only need touching if
# SENAPRED changes its own infra. Everything else about this adapter
# (poll interval, base URLs, query limit) is DB-editable via /config. ---
ADAPTERS_SENAPRED_IDENTITY_POOL_ID=us-east-1:17c696bc-53e1-49a2-991f-f1b65f752fda
ADAPTERS_SENAPRED_COGNITO_REGION=us-east-1
ADAPTERS_SENAPRED_APPSYNC_REGION=us-east-1
ADAPTERS_SENAPRED_APPSYNC_HOST=rz2uv7ifxbgflh2bqmp6kmh4le.appsync-api.us-east-1.amazonaws.com

# --- Secrets (actions.ai) — only used if you set ACTIONS_AI_ENABLED=true
# and pick a provider via /config. Never committed; leave unset unless
# you're using that provider. ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
