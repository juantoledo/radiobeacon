# Copy this file to .env and fill in real values. Never commit .env itself.
#
# Naming convention: vars specific to one adapter are prefixed with the
# adapter's name (e.g. ADAPTERS_SENAPRED_*) so it's clear what they configure and to
# avoid collisions as more adapters are added. Generic vars (used across
# adapters, or read directly by a third-party SDK under its own standard
# name) have no prefix.

# --- Display timezone (adapters.timeutil) — generic, used by any package ---
# Every datetime stored/processed internally is UTC, always (see "Dates
# and times: always UTC" in README.md) — this var does NOT change that.
# It's for presentation only: adapters.timeutil.to_display_tz() converts
# a UTC datetime to this zone for anything shown to a person (a future
# UI, a human-readable log/notification line). An IANA zone name.
DISPLAY_TIMEZONE=America/Santiago

# --- Adapter scheduling (adapters.__main__) — generic, used by any adapter ---
# `data-adapters/start.sh` runs every discovered adapter as its own ongoing loop,
# in parallel. Each adapter polls on its own interval: set
# ADAPTERS_<NAME>_INTERVAL_SECONDS (e.g. ADAPTERS_SENAPRED_INTERVAL_SECONDS)
# to override just that adapter, or leave unset to fall back to this
# package-wide default.
ADAPTERS_DEFAULT_INTERVAL_SECONDS=10

# --- SENAPRED adapter (adapters.senapred) ---
# None of these are secrets — they're public values reverse-engineered from
# senapred.cl's own JS bundle (see the module docstring in
# data-adapters/src/adapters/senapred/__init__.py). All optional; each defaults
# to the current known-working value, so leaving them unset changes nothing.

# How often (seconds) this adapter fetches. Leave unset to use
# ADAPTERS_DEFAULT_INTERVAL_SECONDS.
ADAPTERS_SENAPRED_INTERVAL_SECONDS=10

# Cognito Identity Pool used for senapred.cl's anonymous-visitor auth flow.
ADAPTERS_SENAPRED_IDENTITY_POOL_ID=us-east-1:17c696bc-53e1-49a2-991f-f1b65f752fda

# AWS region for the Cognito Identity Pool above.
ADAPTERS_SENAPRED_COGNITO_REGION=us-east-1

# AWS region for the AppSync GraphQL API (SigV4 signing).
ADAPTERS_SENAPRED_APPSYNC_REGION=us-east-1

# AppSync GraphQL API host (no scheme/path — https:// and /graphql are
# added automatically).
ADAPTERS_SENAPRED_APPSYNC_HOST=rz2uv7ifxbgflh2bqmp6kmh4le.appsync-api.us-east-1.amazonaws.com

# Base URLs used to build each item's public link (urlAccess slug is
# appended). SENAPRED's site links Alerta and Evento items under distinct
# singular paths (/alerta/, /evento/) — /eventos/ is only the listing page.
ADAPTERS_SENAPRED_ALERTA_BASE_URL=https://senapred.cl/alerta/
ADAPTERS_SENAPRED_EVENTO_BASE_URL=https://senapred.cl/evento/

# Max items fetched per feed (alertasByDate / eventosByDate), each call.
ADAPTERS_SENAPRED_QUERY_LIMIT=20

# --- CSN adapter (adapters.csn) ---
# Not a secret — an unofficial public mirror of Chile's Centro Sismológico
# Nacional earthquake list, no auth required. Optional; defaults to the
# current known-working value.

# How often (seconds) this adapter fetches. Leave unset to use
# ADAPTERS_DEFAULT_INTERVAL_SECONDS.
ADAPTERS_CSN_INTERVAL_SECONDS=10

ADAPTERS_CSN_API_URL=https://api.gael.cloud/general/public/sismos

# Public site linked from every item's url (no per-earthquake detail page
# exists in the API's data, so every item points at the same homepage).
ADAPTERS_CSN_SITE_URL=https://www.sismologia.cl/

# Earthquakes at/above this magnitude get dispatch_policy="urgent",
# below it "informational" — see dispatcher/README.md's
# "Delivery repeat policy (dispatch_policy)" section.
ADAPTERS_CSN_URGENT_MAGNITUDE_THRESHOLD=4.5

# CSN's API gives no explicit timezone on its `Fecha` field. An IANA zone
# name stating which timezone that naive timestamp is understood to
# represent, used to convert it to UTC for `source_date_time` (see "Dates
# and times: always UTC" in README.md). Best-effort assumption, not
# officially documented by CSN — correct here in one line if it's ever
# proven wrong. Does NOT affect the item's id/event_key, which
# deliberately keep using the raw, unconverted value.
ADAPTERS_CSN_SOURCE_TZ=America/Santiago

# --- Dispatcher (dispatcher.__main__) — fires when new items appear in the DB ---

# How often (seconds) dispatcher polls storage/radiobeacon.db for new items.
# Cheap local SQLite query, not an external API call — keep this short.
DISPATCHER_INTERVAL_SECONDS=5

# Name of this delivery pipeline — its own row in dispatcher_state tracks
# progress independently of any other consumer. Only matters once more
# than one handler pipeline exists.
DISPATCHER_CONSUMER_NAME=log

# Delivery repeat policy (repeat_times/interval_seconds per named policy)
# is NOT configured here — it lives in the dispatch_policies table,
# managed via ./dispatcher/policies.sh (list/set/delete). See
# dispatcher/README.md.

# --- MQ publishing (dispatcher.mq_publisher) — publishes select dispatcher
# audit events to a local MQTT broker as CloudEvents (structured content
# mode: the full envelope, JSON-encoded, as the MQTT payload). This is
# also the ONLY way the actions/ package (chunk, ai) learns about new or
# re-armed items — dispatcher publishes item.dispatched here, and actions
# subscribes to that same topic — so leaving DISPATCHER_MQ_HOST unset
# makes chunk/ai permanently inert even if actions and the broker are
# both running. Comment it out (or leave empty) to disable publishing
# entirely (no connection ever attempted). Only these 6 event types are
# published: item.dispatched, item.dispatch_failed, item.discovered,
# item.policy_drifted, item.policy_overridden, item.rearmed — see
# dispatcher/README.md.

# Host of the MQTT broker to publish to. Defaults to the local broker
# mq/start.sh brings up (bootstrap.sh starts it automatically) — see
# mq/README.md and mq/docker-compose.yml.
DISPATCHER_MQ_HOST=localhost

# Port of the MQTT broker. Has a Python-side default (1883, MQTT's
# standard unencrypted port), so it doesn't need to be set here unless
# you're pointing at something nonstandard.
DISPATCHER_MQ_PORT=1883

# MQTT QoS level for published events. 1 ("at least once") is the
# default — a reasonable middle ground for this repo's local, low-volume
# use case; 0 ("at most once", fire-and-forget) trades reliability for
# slightly less broker-side bookkeeping, 2 ("exactly once") adds
# handshake overhead this use case doesn't need.
DISPATCHER_MQ_QOS=1

# How long (seconds) to wait when connecting/publishing before giving up —
# keeps a hung/misbehaving broker from stalling dispatcher's poll loop.
DISPATCHER_MQ_CONNECT_TIMEOUT_SECONDS=5

# --- Actions (actions.__main__) — subscribes to MQTT topics, chains
# processing across N independently-configured actions. Also defaults to
# the local broker (same one DISPATCHER_MQ_HOST above publishes to) —
# actions has nothing to do without a broker carrying dispatcher's
# published events. See actions/README.md.

ACTIONS_MQ_HOST=localhost
ACTIONS_MQ_PORT=1883
ACTIONS_MQ_QOS=1

# How long (seconds) to wait between reconnect attempts if the broker is
# unreachable at startup or drops mid-run.
ACTIONS_MQ_RECONNECT_BACKOFF_SECONDS=5

# --- ai action (actions.ai) — on item.dispatched, asks an LLM provider to
# summarize the item, storing the result in items.summary. ALWAYS
# publishes to ACTIONS_AI_OUTPUT_TOPIC once it has a valid (source,
# item_id) — even when it decides there's nothing to summarize (disabled,
# already-short content, item not found, bad provider config), with a
# `summarized: false` marker — so actions.chunk (below), which now
# subscribes to this action's output rather than item.dispatched
# directly, always runs AFTER ai has settled and still fires even when AI
# is disabled (the default). Disabled by default (unlike chunk, this has
# a real per-call cost — a paid API, or a hard dependency on a local
# Ollama install) — opt in explicitly.
# Every action has its own ACTIONS_<NAME>_SUBSCRIBE_TOPIC (required — the
# action is skipped if unset) and ACTIONS_<NAME>_OUTPUT_TOPIC (optional —
# omit for a terminal action with nothing to publish downstream).

ACTIONS_AI_ENABLED=false
ACTIONS_AI_SUBSCRIBE_TOPIC=radiobeacon/events/item.dispatched
ACTIONS_AI_OUTPUT_TOPIC=radiobeacon/events/item.ai_settled
ACTIONS_AI_OUTPUT_EVENT_TYPE=item.ai_settled

# Which provider to call: openai, claude, or ollama. Required once
# ACTIONS_AI_ENABLED=true — no default, so this never silently calls a
# paid API (or silently doesn't) by guessing.
# ACTIONS_AI_PROVIDER=ollama

# ANTHROPIC_API_KEY / OPENAI_API_KEY (unprefixed — read directly by each
# SDK under its own standard name, per this file's naming convention
# above) are only needed for the provider actually selected.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

ACTIONS_AI_CLAUDE_MODEL=claude-haiku-4-5
ACTIONS_AI_OPENAI_MODEL=gpt-4o-mini
ACTIONS_AI_OLLAMA_MODEL=llama3.2:1b
ACTIONS_AI_OLLAMA_HOST=http://localhost:11434

# Skip threshold on the INPUT (extracted_contents), not a cap on the
# output: if the content is already at or under this many characters,
# there's nothing meaningful to condense, so the provider is never
# called. Whatever the provider actually returns is stored/published
# verbatim — never truncated.
ACTIONS_AI_MAX_CHARS=200

# Optional str.format-style override of the default Spanish summarization
# prompt. Available fields: extracted_title, extracted_contents, type,
# subtype, url.
# ACTIONS_AI_PROMPT=

# --- chunk action (actions.chunk) — subscribes to ai's own output
# (above), not item.dispatched directly, so it always runs AFTER ai has
# settled: chunks items.summary when ai produced one, else falls back to
# extracted_contents (same summary-else-raw pattern beacon's own voice
# resolution uses). Published to ACTIONS_CHUNK_OUTPUT_TOPIC for
# actions.content_ready (below) to pick up.

ACTIONS_CHUNK_SUBSCRIBE_TOPIC=radiobeacon/events/item.ai_settled
ACTIONS_CHUNK_OUTPUT_TOPIC=radiobeacon/events/item.chunked
ACTIONS_CHUNK_OUTPUT_EVENT_TYPE=item.chunked

# Max characters per chunk (word-boundary-aware, never cuts mid-word) —
# a ceiling, not a fixed size: actions.chunk dynamically clamps this down
# further at runtime if BEACON_CALLSIGN/BEACON_FRAME_DESTINATION/
# BEACON_FRAME_PREFIX/BEACON_FRAME_SUFFIX (below) would otherwise risk an
# assembled AX.25 frame exceeding its ~256-byte limit (see CONTEXT.md) —
# 200 is just a safe-ish starting point assuming a short callsign and no
# prefix/suffix configured.
ACTIONS_CHUNK_MAX_CHARS=200

# content_ready watches for items where both actions.chunk and actions.ai
# have finished reacting to the same dispatch, and publishes one
# item.content_ready event per item once they have — the single, race-free
# trigger beacon subscribes to (see below), instead of racing on
# item.chunked/item.dispatched independently the way frame/voice used to.
ACTIONS_CONTENT_READY_POLL_INTERVAL_SECONDS=2
ACTIONS_CONTENT_READY_OUTPUT_TOPIC=radiobeacon/events/item.content_ready

# --- Beacon (beacon.__main__) — the TDMA transmission orchestrator: queues
# incoming content and delivers it to voice (SvxLink) or AX.25 frame
# (Direwolf) channels inside a repeating time window. See beacon/README.md
# and CONTEXT.md for the full design. Disabled by default (BEACON_ENABLED)
# — also requires the beacon identity fields (BEACON_CALLSIGN etc., DB-only,
# set via the UI's /beacon page, never here) to be configured.
#
# Frame content requires actions.chunk (always-on by default) and reuses
# its ACTIONS_CHUNK_MAX_CHARS for length, not a separate beacon setting.
# Voice content prefers actions.ai's summary when enabled/available,
# falling back to the item's raw extracted_contents (truncated to
# ACTIONS_AI_MAX_CHARS) otherwise — so voice works out of the box too, just
# less polished for AI-eligible sources until ACTIONS_AI_ENABLED=true.

BEACON_ENABLED=false

# TDMA window: total cycle length, and how much of it is voice vs. frame.
# guard_seconds (0 = no gap) is time between the two slots so the outgoing
# transmitter can release the shared audio device before the next one
# opens it — see the audio-contention note below.
BEACON_WINDOW_TOTAL_SECONDS=90
BEACON_WINDOW_VOICE_SECONDS=60
BEACON_WINDOW_FRAME_SECONDS=30
BEACON_WINDOW_GUARD_SECONDS=0

# How often the TDMA loop re-evaluates the schedule. Small relative to the
# slot lengths so short slots aren't missed.
BEACON_TICK_SECONDS=1

# How long before a content slot's start to stop/start SvxLink or Direwolf
# (see BEACON_SERVICE_CONTROLLER below), so the target service is ready by
# the time the slot actually begins. A placeholder — CONTEXT.md's own
# PTT_LATENCY_S/TNC_LATENCY_S need measuring on the real hardware.
BEACON_SLOT_LEAD_TIME_SECONDS=2

# When a slot opens with more than one item queued, the TDMA loop drains
# the whole backlog (not just one item) before handing off to the next
# slot — these are the gaps between consecutive transmissions within that
# drain, so PTT can release/re-key and the TNC/listener can clear the
# previous one. Placeholders, same "needs real hardware measurement"
# caveat as BEACON_SLOT_LEAD_TIME_SECONDS.
BEACON_VOICE_INTER_TX_DELAY_SECONDS=2
BEACON_FRAME_INTER_TX_DELAY_SECONDS=2

# strftime format for {date} below — items.source_date_time, converted
# from UTC to DISPLAY_TIMEZONE at transmit time (presentation only, per
# the root README's "always UTC" storage rule). Shared by both voice and
# frame. Stick to fixed-width numeric directives (%d/%m/%Y/%H/%M) — a
# weekday/month name (%A/%B) varies in width and isn't accounted for by
# actions.chunk's AX.25 overflow-safety clamp (see ACTIONS_CHUNK_MAX_CHARS).
BEACON_DATE_FORMAT=%d-%m-%Y %H:%M

# str.format-style template wrapping resolved voice content. Placeholders:
# {callsign}, {text}, {date} (blank if the item has no source_date_time).
# Frame content has no template — its ORIGEN>DESTINO:contenido structure
# is fixed protocol code, not user-editable, so a misconfigured template
# can never corrupt it.
BEACON_VOICE_TEMPLATE={callsign}. {text}. {date}

# AX.25 destination address (tocall) — a software/project identifier, not
# a real route. WXALRT marks this as experimental, non-APRS traffic (see
# CONTEXT.md's "Compatibilidad con AX.25 / APRS" section).
BEACON_FRAME_DESTINATION=INFO

# Prepended/appended to the actual transmitted frame payload (not the
# tocall address above) — applied to every frame, including each chunk of
# a multi-frame item, so a listener catching only one still sees it. Also
# str.format templates — {date} is available here too (e.g.
# " {date}"), though left out of the default since frame's byte budget
# is already tight; see actions.chunk's dynamic ACTIONS_CHUNK_MAX_CHARS
# clamp, which accounts for a {date} placeholder's rendered length, not
# just the raw template's. Counts against the same 256-byte AX.25 hard
# limit as the rest of the frame. Empty by default.
BEACON_FRAME_PREFIX={date}
# BEACON_FRAME_SUFFIX= [EXPERIMENTAL]

# Direwolf's KISS TCP socket (see CONTEXT.md — port 8001 is Direwolf's own
# default). Requires a real Direwolf instance to actually transmit;
# deploying Direwolf itself is out of scope for this repo.
BEACON_AX25_KISS_HOST=localhost
BEACON_AX25_KISS_PORT=8001
BEACON_AX25_CONNECT_TIMEOUT_SECONDS=5

# "logging" (default, safe) just logs what would be played instead of
# touching real hardware/SvxLink — the only voice path verifiable without
# the real shack host. "svxlink" is an unverified stub — see
# beacon/README.md and CONTEXT.md's own open TODO on SvxLink's
# remote-control mechanism.
BEACON_VOICE_TRANSMITTER=logging

# TTS engine: "espeak" (default, offline/zero-setup, robotic-sounding —
# apt install espeak-ng) or "piper" (offline neural TTS, much more natural,
# but needs a separately downloaded .onnx voice model — see
# https://github.com/rhasspy/piper/releases/tag/v0.0.2). text -> speech is
# real and testable either way; getting the WAV onto the air via SvxLink is
# the unverified part above.
BEACON_TTS_ENGINE=espeak

# espeak-ng voice/language code (only applies when BEACON_TTS_ENGINE=espeak)
BEACON_TTS_VOICE=es

# Path to a downloaded piper .onnx voice model (its .onnx.json sidecar must
# sit alongside it) and the command used to invoke piper. Only apply when
# BEACON_TTS_ENGINE=piper; BEACON_TTS_PIPER_MODEL is required in that case.
BEACON_TTS_PIPER_MODEL=
BEACON_TTS_PIPER_BINARY=piper

# Output directory for synthesized WAV files, regardless of engine.
BEACON_TTS_WAV_DIR=storage/beacon_tts

# Max items held per channel (voice/frame) before the oldest is dropped to
# make room for new content — a beacon broadcasts current state, not a
# perfect history, so a backlog from an extended disabled period
# represents the newest items once re-enabled, not the stale oldest ones.
# 200, not a small number: frame content is one queue slot PER CHUNK, not
# per item — a real SENAPRED report has been observed producing 57
# chunks on its own. A cap too close to that risks silently dropping the
# tail of a single large item (confirmed live: beacon.queue.dropped
# firing hundreds of times against the old default of 20).
BEACON_QUEUE_MAX_SIZE=200

# How often beacon checks for an item.content_ready publish its own MQTT
# subscription missed (a message published while briefly offline, or a
# startup race against actions.content_ready) and enqueues it anyway,
# instead of relying on MQTT delivery alone. Runs once immediately on
# startup regardless of this interval — that's what closes the startup
# race specifically.
BEACON_CONTENT_READY_RECONCILE_INTERVAL_SECONDS=30

# MQTT broker beacon subscribes to for incoming content — same local
# broker every other package uses (see mq/README.md).
BEACON_MQ_HOST=localhost
BEACON_MQ_PORT=1883
BEACON_MQ_QOS=1
BEACON_MQ_RECONNECT_BACKOFF_SECONDS=5

# The single trigger feeding both the voice and frame queues — published
# by actions.content_ready once both chunk and AI have finished with an
# item (see ACTIONS_CONTENT_READY_* above). Frame gets one item per
# existing chunk if no summary existed at publish time, or a single
# summary-based frame if one did; voice always resolves summary-else-raw
# at transmit time regardless.
BEACON_CONTENT_READY_SUBSCRIBE_TOPIC=radiobeacon/events/item.content_ready

# NTP — observability only. The OS's own NTP daemon (systemd-timesyncd/
# chronyd) does actual clock discipline; beacon never adjusts the clock
# itself, only reports how far off it currently measures, for visibility
# in the UI. BEACON_NTP_SERVER is queried at startup and every
# BEACON_NTP_CHECK_INTERVAL_SECONDS; an offset past
# BEACON_NTP_MAX_OFFSET_SECONDS is logged loudly but never blocks
# transmission.
BEACON_NTP_SERVER=pool.ntp.org
BEACON_NTP_CHECK_INTERVAL_SECONDS=3600
BEACON_NTP_MAX_OFFSET_SECONDS=2.0

# Audio-device contention between SvxLink and Direwolf (CONTEXT.md's own
# "hallazgo crítico" — they can't both hold the same audio hardware at
# once) is handled by actively stopping/starting each service around its
# slot. "logging" (default, safe) just logs the start/stop it would issue.
# "systemctl" actually controls SvxLink/Direwolf via systemd — requires a
# scoped passwordless sudoers rule on the host for exactly
# `systemctl {start,stop} svxlink`/`direwolf` (NOT unrestricted sudo) —
# see beacon/README.md. Deploying Direwolf/SvxLink themselves (their
# Dockerfiles, compose, host audio provisioning) is out of scope for this
# repo — both are assumed to already run as independently controllable
# systemd services on the host.
BEACON_SERVICE_CONTROLLER=logging
BEACON_SVXLINK_SERVICE_NAME=svxlink
BEACON_DIREWOLF_SERVICE_NAME=direwolf

# --- UI (ui.app) — server-rendered ops dashboard (FastAPI + Jinja2, no JS
# framework): browse/search items, override dispatch_policy, rearm items,
# manage dispatch_policies, view the audit log. Localhost-only by
# convention (no auth in this first version) — see ui/README.md.

# Host/port ui/start.sh binds to. Defaults to 0.0.0.0 (reachable from the
# LAN) — there is no auth yet, so only run this on a trusted network. Set
# to 127.0.0.1 to keep it off the network entirely (loopback-only).
UI_HOST=0.0.0.0
UI_PORT=8000

# Path to radiobeacon.db. Leave unset to use the same default every other
# package uses (adapters.storage.DEFAULT_DB_PATH, storage/radiobeacon.db).
# UI_DB_PATH=

# Rows per page on the items list and audit log viewer.
UI_PAGE_SIZE=50

# Consumer name prefilled on the item detail page's rearm form
# (dispatcher_state/trigger_dispatches are tracked per consumer — see
# dispatcher/README.md). Defaults to DISPATCHER_CONSUMER_NAME if that's
# set, else "log".
# UI_DEFAULT_CONSUMER_NAME=

# How often (seconds) the dashboard page's browser-side auto-refresh
# re-polls for new items/audit events, swapping the content in place with
# no full page reload. Set to 0 to disable (the page only updates on a
# manual reload).
UI_DASHBOARD_REFRESH_SECONDS=5

# Same, for /beacon's own live status section (cycle timeline, slot
# countdown, queue cards) — tighter default since a countdown only reads
# as "live" with frequent updates.
UI_BEACON_REFRESH_SECONDS=2

# Enables the Developers section (/dev): raw item add/edit/delete, a
# dispatcher-state debug reset, and a read-only SQL runner. A meaningfully
# larger attack surface than the rest of this auth-less, localhost-by-
# default app (items are normally immutable after insert except summary/
# dispatch_policy — /dev is an explicit escape hatch around that). Set to
# false to 404 every /dev/* route and hide its nav link, without
# disabling the rest of the UI.
UI_DEV_TOOLS_ENABLED=true
